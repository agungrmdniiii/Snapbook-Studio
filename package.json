{
  "name": "snapbook-studio",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "seed": "tsx prisma/seed.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@vercel/blob": "2.8.2",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^15.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "playwright": "^1.64.0",
    "postcss": "^8.5.31",
    "prisma": "^6.4.1",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "postcss": "$postcss",
