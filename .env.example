# Database Configuration (Supabase PostgreSQL / Cloud DB)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# App & Session Security
APP_URL="http://localhost:3000"
SESSION_SECRET=""

# Isi sebelum seed; seed tidak mereset akun admin yang sudah ada.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# Upload Vercel Blob memakai konfigurasi server yang ditambahkan otomatis saat store ditautkan.
# BLOB_READ_WRITE_TOKEN / BLOB_STORE_ID + OIDC tidak boleh memakai awalan NEXT_PUBLIC_.
# Alternatif: Supabase Storage (server-only); URL HTTPS tetap dapat dipakai tanpa Storage.
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
