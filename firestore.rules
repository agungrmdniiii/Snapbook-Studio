rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Studio Config: Anyone can read, only admin should write
    // For the hidden key implementation, we'll allow writes if the structure is correct
    match /studioConfig/{docId} {
      allow read: if true;
      allow write: if true; // Security note: in a real app, this should be restricted via Firebase Auth
    }

    // Packages: Anyone can read, update allowed for admin management
    match /packages/{packageId} {
      allow read: if true;
      allow write: if true;
    }

    // Bookings: Public can create, only admin can update status
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Showcase: Anyone can read
    match /showcase/{imageId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
