rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------------------
    // GLOBAL HELPERS
    // -------------------------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // -------------------------------------------------------------------------
    // DEFAULT DENY
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // STUDIO CONFIG
    // -------------------------------------------------------------------------
    match /studioConfig/{docId} {
      allow read: if true;
      // In this specific app, we allow unrestricted write for config management 
      // but ideally this would be gated by an admin check if we had auth established
      allow write: if true; 
    }

    // -------------------------------------------------------------------------
    // PACKAGES
    // -------------------------------------------------------------------------
    match /packages/{packageId} {
      allow read: if true;
      allow write: if true;
    }

    // -------------------------------------------------------------------------
    // BOOKINGS
    // -------------------------------------------------------------------------
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // -------------------------------------------------------------------------
    // SHOWCASE
    // -------------------------------------------------------------------------
    match /showcase/{imageId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
